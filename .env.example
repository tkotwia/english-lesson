# 複製成 .env 後再修改。沒有 .env 也能啟動,會使用下列預設值。
# 注意:Google API key 不放在這裡,由每位使用者在網頁的「設定」頁貼上。

# AI 供應商:gemini(預設)或 mock(假資料,開發測試用,不耗額度)
AI_PROVIDER=gemini

# 品質類模型(產生課程、批改對話與寫作)。逗號分隔,前面的不可用時依序改用後面的。
# 2026-11-20 實測產生一堂課:hydrogen 40–61 秒(忙線時會立刻失敗、換下一個);
# 3.8-flash 79 秒;flash-lite 約 8 秒但題目會出錯,只當最後備援。
AI_MODELS_QUALITY=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.5-flash-lite

# 品質類的思考程度:default(交給模型決定,預設值)、minimal、low、medium、high。
# 調低會變快(實測 3.8-flash 從 79 秒降到 24–33 秒),但對指示遵循得較不精確。
AI_THINKING_QUALITY=default

# 單次呼叫最多等幾秒。超過就放棄這個模型,改用下一個。
AI_TIMEOUT_QUALITY_SECONDS=180
AI_TIMEOUT_CHAT_SECONDS=30

# 預先備課:on(預設)表示開始上一堂課時,就在背景把下一堂準備好,下次不用等。
# 設成 off 則每次按「開始」時才現場產生(要等 40–80 秒),但不會提前用掉額度。
AI_PREPARE_NEXT=on

# 對話類模型(情境對話、問老師)。
AI_MODELS_CHAT=gemini-3.5-flash-lite

# 本機伺服器連接埠
PORT=3210

# 進度資料存放位置(內含 english.db)
DATA_DIR=./data
