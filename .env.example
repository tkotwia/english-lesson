# 複製成 .env 後再修改。沒有 .env 也能啟動,會使用下列預設值。
# 注意:Google API key 不放在這裡,由每位使用者在網頁的「設定」頁貼上。

# AI 供應商:gemini(預設)或 mock(假資料,開發測試用,不耗額度)
AI_PROVIDER=gemini

# 品質類模型(產生課程、批改對話與寫作、出分級測驗的題目)。逗號分隔,前面的不可用時依序改用後面的。
# 2026-11-20 實測產生一堂課:hydrogen 40–61 秒(忙線時會立刻失敗、換下一個);
# 3.8-flash 79 秒;flash-lite 約 8 秒但題目會出錯,只當最後備援。
AI_MODELS_QUALITY=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.5-flash-lite

# 品質類的思考程度:default(交給模型決定,預設值)、minimal、low、medium、high。
# 調低會變快(實測 3.8-flash 從 79 秒降到 24–33 秒),但對指示遵循得較不精確。
AI_THINKING_QUALITY=default
# 對話類的思考程度,選項相同。
AI_THINKING_CHAT=default

# 單次呼叫最多等幾秒。超過就放棄這個模型,改用下一個。
AI_TIMEOUT_QUALITY_SECONDS=180
AI_TIMEOUT_CHAT_SECONDS=30

# 預先備課:on(預設)表示一堂課開始後,就在背景把下一堂課準備好,下次不用等;分級測驗也會在作答時備好下一份題目。
# 設成 off 則不會提前用掉額度:下一堂課要在開始上課的畫面按「備課」才準備(要等 40–80 秒)。
# 不論開或關,每個等級的第一堂課都使用程式內建的起始課,不必等。
# (課程長度依學習階段固定:國小 20、國中 25、高中與大學 30 分鐘,所以每個等級只備一堂。)
AI_PREPARE_NEXT=on

# 即時語音對話(課程裡的情境對話,以及「即時對話」頁面)使用的模型。
AI_MODEL_LIVE=gemini-3.8-live

# 聽力音檔:on(預設)表示在背景用語音合成把聽力課文與聽寫句子事先唸好,聲音比瀏覽器朗讀自然;
# 還沒做好或額度用完時,那一段由瀏覽器朗讀。設成 off 則完全不用,全部由瀏覽器朗讀。
AI_SPEECH=on
# 語音合成的模型。逗號分隔,前面的到上限時改用後面的。
# 2026-11-24 在免費方案看到的上限:每個模型每分鐘 3 次、每日 10 次;一堂課用 3 次。
AI_MODELS_SPEECH=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts

# 對話類模型(情境對話、問老師)。
AI_MODELS_CHAT=gemini-3.5-flash-lite

# 本機伺服器連接埠
PORT=3210

# 進度資料存放位置(內含 english.db)
DATA_DIR=./data
